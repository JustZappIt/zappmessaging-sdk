  try {
    return length ? await MerkleTree.getRootsFromStorage(storage, length) : []
  } catch (err) {
    if (err.code !== 'INVALID_OPERATION') throw err
    // If INVALID_OPERATION, a root is likely missing so load empty roots to try to recover
    return []
  }
}

