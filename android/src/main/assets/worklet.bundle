  },
  "files": [
    "index.js"
  ],
  "dependencies": {
    "b4a": "^1.5.3",
    "z32": "^1.0.0"
  },
  "devDependencies": {
    "brittle": "^3.1.1",
    "hypercore": "^10.0.0",
    "random-access-memory": "^6.0.0",
    "standard": "^17.1.0"
  },
