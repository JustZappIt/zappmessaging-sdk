  "name": "simdle-universal",
  "version": "1.1.2",
  "description": "Universal wrapper for libsimdle with a JavaScript fallback",
  "main": "index.js",
  "files": [
    "fallback.js",
    "index.js",
    "scalar.js"
  ],
  "browser": {
    "./index.js": "./fallback.js"
  },
