# Dependencies
node_modules/

# Build artifacts
android/build/
ios/build/

# Generated JavaScript bundle (regenerated by build script)
ios/Resources/worklet.bundle
ios/Resources/worklet-manifest.json

# Test coverage
coverage/
.nyc_output/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local

# Temporary files
tmp/
temp/
*.tmp
*.backup

# Data directories (for local testing)
/data/
/media/
/chats/

# Blind-peer runtime state. The Corestore here holds the peer's secret primary
# key, which is what its published public key is derived from.
/blind-peer-data/
/.bp-data/

# Swift/Xcode
# The Xcode project is generated from ios/project.yml by XcodeGen and is never
# committed: XcodeGen resolves ${PWD} and ${PATH} at generation time, so a
# committed .pbxproj carries the generating machine's absolute paths and full
# shell PATH. Run `xcodegen generate` in ios/ to produce it locally.
ios/ZappMessaging.xcodeproj/
DerivedData/
.build/
*.swiftpm

# Native addon frameworks (regenerated by bare-link)
ios/Addons/*.xcframework/

# Android
*.iml
.gradle/
local.properties
*.apk
*.aab

# Local scratch
REF_*/
